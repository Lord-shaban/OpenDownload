# Copy to .env for Docker; native processes read environment variables directly.
OD_PORT=8080
OD_DATA_DIR=.data
OD_EGRESS_PROXY=http://127.0.0.1:8090
OD_ORIGIN=http://localhost:3000
OD_WORKERS=2
OD_QUEUE_LIMIT=20
OD_MAX_BYTES=536870912
OD_JOB_TIMEOUT=15m
OD_RETENTION=1h
OD_FIXTURE_MODE=false
OD_YTDLP=yt-dlp
API_URL=http://127.0.0.1:8080
